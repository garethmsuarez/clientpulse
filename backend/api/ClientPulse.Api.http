@ClientPulse.Api_HostAddress = http://localhost:5114

GET {{ClientPulse.Api_HostAddress}}/api/clients
Accept: application/json

###

GET {{ClientPulse.Api_HostAddress}}/api/clients/1
Accept: application/json

###

# Unknown client: 404 problem details
GET {{ClientPulse.Api_HostAddress}}/api/clients/999
Accept: application/json

###

GET {{ClientPulse.Api_HostAddress}}/api/clients/1/communications
Accept: application/json

###

# Synthetic example only
POST {{ClientPulse.Api_HostAddress}}/api/clients/1/communications
Content-Type: application/json

{
  "type": "Email",
  "occurredAt": "2026-11-02T15:00:00Z",
  "subject": "Synthetic follow-up",
  "body": "Synthetic body text for local testing."
}

###

# Fixture analysis (not real inference). 201, 409 no communications,
# 422 unsupported fixture input, 500 invalid analyzer output, 404 unknown client.
POST {{ClientPulse.Api_HostAddress}}/api/clients/3/assessments
Accept: application/json

###

# 200 latest assessment, 204 (no body) when none yet, 404 unknown client
GET {{ClientPulse.Api_HostAddress}}/api/clients/3/assessments/latest
Accept: application/json

###

# Assessment history, newest first (200; empty list when none)
GET {{ClientPulse.Api_HostAddress}}/api/clients/3/assessments
Accept: application/json

###

# One assessment with its review history (404 if it belongs to another client)
GET {{ClientPulse.Api_HostAddress}}/api/clients/3/assessments/1
Accept: application/json

###

# Review the latest assessment (synthetic example). 201, 400 field errors,
# 404, or 409 when a newer assessment exists. reviewerName is self-reported.
POST {{ClientPulse.Api_HostAddress}}/api/clients/3/assessments/1/reviews
Content-Type: application/json

{
  "decision": "Adjusted",
  "reviewedAttentionLevel": "Medium",
  "notes": "Synthetic review note.",
  "reviewerName": "Synthetic Reviewer"
}

###

# Active analyzer (Fixture or Anthropic, with model and effort). No secrets.
GET {{ClientPulse.Api_HostAddress}}/api/analysis/provider
Accept: application/json

###
